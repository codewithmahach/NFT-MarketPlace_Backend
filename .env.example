PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/chainart_marketplace
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Sepolia RPC Configuration
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
FALLBACK_RPC_URL_1=https://rpc.sepolia.org
FALLBACK_RPC_URL_2=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111

# Smart Contract Proxy Addresses (Sepolia)
NFT_CONTRACT_ADDRESS=0x0f111da5e9364656F54b5F402F1B8D2598808ba5
MARKETPLACE_CONTRACT_ADDRESS=0x09671389c8666615F76CE06445465fb9b840110A
AUCTION_CONTRACT_ADDRESS=0x6770771d0cB72f6853741d2Fa21A30817F5987d0
LOYALTY_CONTRACT_ADDRESS=0xa6c74aE1348932243B1C9f757755D27E652eE306
USDT_CONTRACT_ADDRESS=0xd077a400968890eacc75cdc901f0356c943e4fdb
TREASURY_ADDRESS=0x041F913a616362e67CdcE5d476F6BDeC7776f309

# Indexer & Data Management Settings
INDEXER_START_BLOCK=7800000
INDEXER_POLL_INTERVAL_MS=15000
ENABLE_SEED_DATA=false

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
AUTH_RATE_LIMIT_MAX=50
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
